# =============================================================================
# KIMIDORI YouTube Auto — 環境変数テンプレート
# このファイルをコピーして .env に名前変更し、各値を設定してください。
# cp .env.example .env
# =============================================================================

# ---- Gemini API ----
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# ---- Google Cloud / Firestore ----
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-northeast1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Cloud Run 上では Workload Identity を推奨（GOOGLE_APPLICATION_CREDENTIALS 不要）

# ---- Firebase / Firestore ----
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=AIzaSy...

# ---- YouTube Data API v3 / OAuth 2.0 ----
YOUTUBE_CLIENT_ID=xxxxxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-...
YOUTUBE_REDIRECT_URI=http://localhost:8080/api/youtube/oauth-callback
# Cloud Run 本番:
# YOUTUBE_REDIRECT_URI=https://your-service-xxxx-an.a.run.app/api/youtube/oauth-callback

# ---- Stripe サブスクリプション ＆ クレジット管理 ----
STRIPE_SECRET_KEY=sk_live_...
# テスト環境:
# STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
# テスト環境:
# STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Webhookエンドポイント（Stripe ダッシュボードで登録）:
# https://your-service-xxxx-an.a.run.app/api/stripe/webhook
# 対象イベント: customer.subscription.created, customer.subscription.updated,
#              customer.subscription.deleted, checkout.session.completed

# ---- VoxCPM / 高品質OSS TTS（ElevenLabs互換） ----
OSS_ELEVENLABS_URL=http://localhost:9880
OSS_ELEVENLABS_KEY=
OSS_ELEVENLABS_VOICE_ID=default
OSS_ELEVENLABS_PROTOCOL=elevenlabs_compatible
# VoxCPM (OpenBMB) 例:
# OSS_ELEVENLABS_URL=https://your-voxcpm.trycloudflare.com
# OSS_ELEVENLABS_KEY=your-api-key-if-any

# ---- Cloudflare Tunnel / ComfyUI / Colab GPU ----
COLAB_WORKER_URL=https://xxxx.trycloudflare.com
# ComfyUI エンドポイント（Colab A100等）
# BYOG ユーザーはフロントエンド設定画面から個別に登録可能

# ---- セキュリティ / サロンiframe連携 ----
SALON_SHARED_SECRET=change-this-to-random-secret-at-least-32-chars
REQUIRE_AUTH_API=false
# 本番環境では REQUIRE_AUTH_API=true を推奨

# ---- Marketing API ----
# Marketing API Token はユーザー毎に Firestore に保存されます。
# 初期発行は設定画面の「マーケティング連携・Webhook設定」パネルから行ってください。
MARKETING_API_ENABLED=true

# ---- Cloud Run / デプロイ設定 ----
CLOUD_RUN_SERVICE_NAME=kimidori-youtube-auto
CLOUD_RUN_REGION=asia-northeast1
# Cloud Run に直接デプロイする場合:
# gcloud run deploy ${CLOUD_RUN_SERVICE_NAME} \
#   --image gcr.io/${GCP_PROJECT_ID}/${CLOUD_RUN_SERVICE_NAME}:latest \
#   --region ${CLOUD_RUN_REGION} \
#   --set-env-vars GEMINI_API_KEY=...,STRIPE_SECRET_KEY=...,etc.

# ---- 一時ファイル / ストレージ ----
TMP_DIR=/tmp/kimidori
GCS_BUCKET_NAME=your-gcs-bucket-name

# ---- BGM ----
BGM_DEFAULT_TRACK=default_bgm.mp3

# ---- その他オプション設定 ----
WHISPER_MODEL=base
SHORT_VIDEO_MAX_DURATION=90
LOG_LEVEL=INFO
